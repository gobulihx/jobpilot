{
  "url": "https://example.com/apply/basic",
  "title": "校园招聘简历",
  "module": "基本信息",
  "controls": [
    {"label": "姓名", "kind": "text", "required": true, "maxlength": 20},
    {"label": "手机号码", "kind": "text", "required": true},
    {"label": "电子邮箱", "kind": "text", "required": true},
    {"label": "身份证号", "kind": "text", "required": true, "maxlength": 18},
    {"label": "出生日期", "kind": "date", "required": true},
    {"label": "学校名称", "kind": "text", "required": true, "maxlength": 20},
    {"label": "专业", "kind": "text", "required": true},
    {"label": "最高学历", "kind": "enum", "required": true, "options": ["本科", "硕士", "博士"]},
    {"label": "预计毕业时间", "kind": "month", "required": true},
    {"label": "求职方向", "kind": "text", "required": false},
    {"label": "意向城市", "kind": "text", "required": false},
    {"label": "身高（cm）", "kind": "number", "required": true},
    {"label": "是否服从调剂", "kind": "enum", "required": true, "options": ["是", "否"]}
  ]
}
